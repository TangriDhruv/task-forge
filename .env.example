# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required: your own Anthropic API key, used by the discovery agent loop.
ANTHROPIC_API_KEY=

# Required only if your key is not itself scoped to a workspace (the API
# rejects calls from such a key with a 400 "not scoped to a workspace"
# error otherwise). Find it in the Anthropic Console under the workspace's
# settings page. Not a secret the way the API key is, but still kept out of
# version control alongside it.
# ANTHROPIC_WORKSPACE_ID=

# Optional: override the default model.
# ANTHROPIC_MODEL=claude-sonnet-5

# Target application config. Default for the local mock CU Servicing Console:
# TARGET_APP_BASE_URL=http://127.0.0.1:5055

# Required only if you want the escalation flow's "save this credential for
# next time" feature (src/cua/escalation/credentials.py) -- without it, saved
# credentials simply can't be stored or read back. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_STORE_KEY=
